GROQ_API_KEY=your_groq_api_key_here
PORT=3001
VITE_API_URL=http://localhost:3001

# Supabase (frontend, PUBLIC)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Supabase (backend, SECRET)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MSG91 OTP Widget (frontend PUBLIC + backend SECRET)
VITE_MSG91_WIDGET_ID=your_msg91_widget_id
VITE_MSG91_TOKEN_AUTH=your_msg91_token_auth
MSG91_AUTHKEY=your_msg91_authkey

# Auth
AUTH_SIGNING_SECRET=generate_a_long_random_string

# Portal credential encryption (backend SECRET, server env only — NEVER in Supabase
# or the frontend). AES-256-GCM key: base64 of 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, the guided journey still works but secure credential storage is disabled.
CREDENTIAL_ENCRYPTION_KEY=generate_a_base64_32byte_key
